# ============================================
# The 5 Agents - Environment Variables Example
# ============================================
# Copy this file to .env and fill in real values.
# Never commit .env to git - only .env.example.

# --- Anthropic / Claude ---
# Used by all agents (Reuven, Yael, Yuval, Chen)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- OpenAI (optional) ---
# For Yuval's image generation (DALL-E) if used
OPENAI_API_KEY=your_openai_api_key_here

# --- Research / Web Search (for Chen) ---
# Pick whichever search/scrape provider you use
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# --- General ---
# Optional: environment mode (development | production)
NODE_ENV=development
